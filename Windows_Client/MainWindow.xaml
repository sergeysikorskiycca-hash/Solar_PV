<Window x:Class="SolarPV.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Solar_PV — Панель станции" Height="790" Width="1180"
        MinHeight="680" MinWidth="980" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}" StateChanged="MainWindow_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="MenuItemHeaderTemplate">
            <TextBlock Text="{Binding}"
                       Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}, Path=Foreground}"
                       TextOptions.TextFormattingMode="Display"/>
        </DataTemplate>
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#24364D"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Foreground" Value="#17202D"/>
                    <Setter Property="Background" Value="#DCE6F2"/>
                    <Setter Property="TextElement.Foreground" Value="#17202D"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#17202D"/>
                    <Setter Property="Background" Value="#DCE6F2"/>
                    <Setter Property="TextElement.Foreground" Value="#17202D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#AAB4C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#31445E"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#405875"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseTitleBarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="#17202D"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#9E2116"/><Setter Property="Foreground" Value="#17202D"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#17263A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="WindowModeText" Text="Solar_PV" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#F4F7FB"/>
            <Button Grid.Column="1" Content="—" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeWindow_Click" ToolTip="Свернуть" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="MaximizeRestoreButton" Grid.Column="2" Content="□" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeRestoreWindow_Click" ToolTip="Развернуть" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Grid.Column="3" Content="×" FontSize="20" Style="{StaticResource CloseTitleBarButtonStyle}" Click="CloseWindow_Click" ToolTip="Закрыть" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>
        <Menu x:Name="MainMenu" Grid.Row="1" Padding="8,3" Background="#17263A" Foreground="#F4F7FB" IsMainMenu="True">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Тема">
                    <MenuItem Header="Светлая" Tag="Light" Click="Theme_Click"/>
                    <MenuItem Header="Office" Tag="Office" Click="Theme_Click"/>
                    <Separator/>
                    <MenuItem Header="Тёмная" Tag="Dark" Click="Theme_Click"/>
                    <MenuItem Header="Графитовая" Tag="Graphite" Click="Theme_Click"/>
                    <MenuItem Header="Синяя" Tag="Blue" Click="Theme_Click"/>
                </MenuItem>
                <MenuItem Header="Дизайн">
                    <MenuItem Header="01 · Цифровой прибор" Tag="Digital" Click="Design_Click"/>
                    <MenuItem Header="02 · Аналоговая станция" Tag="Analog" Click="Design_Click"/>
                    <MenuItem Header="03 · Энергосхема" Tag="EnergyMap" Click="Design_Click"/>
                    <MenuItem Header="04 · Энергетический поток" Tag="Flow" Click="Design_Click"/>
                    <MenuItem Header="09 · Технический чертёж" Tag="Blueprint" Click="Design_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Инструменты">
                <MenuItem Header="Подключить ESP32" Click="Connect_Click"/>
                <MenuItem x:Name="AdminMenuItem" Header="Администратор" Click="Admin_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="Проверить обновления…" Click="CheckUpdates_Click"/>
                <Separator/>
                <MenuItem Header="О программе Solar_PV" Click="About_Click"/>
            </MenuItem>
            <MenuItem x:Name="CreateMenuItem" Header="Создать" Visibility="Collapsed">
                <MenuItem Header="Кнопку">
                    <MenuItem Header="Прямоугольник"/>
                    <MenuItem Header="Скруглённый прямоугольник"/>
                    <MenuItem Header="Квадрат"/>
                    <MenuItem Header="Круг"/>
                    <MenuItem Header="Овал"/>
                    <MenuItem Header="Капсула"/>
                </MenuItem>
                <MenuItem Header="График"/>
                <MenuItem Header="Текст"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="2" Margin="26,18,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Солнечная генерация" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="DataModeText" Text="  ·  демонстрационные данные" Foreground="#8FA2BA" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="AddressBox" Width="190" Text="http://192.168.4.1" Padding="10,8"
                         Background="#17263A" Foreground="#E8EEF7" BorderBrush="#30445E" VerticalContentAlignment="Center"/>
                <Button x:Name="ConnectButton" Content="Подключить ESP32" Click="Connect_Click" Margin="9,0,0,0"
                        Padding="15,8" Background="#F5B942" Foreground="#17202D" BorderThickness="0" FontWeight="SemiBold"/>
                <Button Content="Демо" Click="Demo_Click" Margin="8,0,0,0" Padding="15,8"
                        Background="#26384D" Foreground="#E8EEF7" BorderThickness="0"/>

            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="DashboardScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="DashboardContentGrid">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid x:Name="AnalogDashboard" Grid.Row="0" Visibility="Collapsed" Margin="0">
                <Viewbox Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Canvas Width="1409" Height="937">
                        <Image Source="pack://application:,,,/Screenshot_1.jpg" Width="1409" Height="937" Stretch="Fill"/>
                        <TextBlock x:Name="AnalogInverterPower" Visibility="Collapsed"/>
                        <TextBlock x:Name="AnalogInverterEnergy" Visibility="Collapsed"/>
                        <Border Canvas.Left="1000" Canvas.Top="16" Width="390" Height="42" Background="#E6103155" BorderBrush="#8BC9F5" BorderThickness="1" CornerRadius="9" Padding="9,5">
                            <TextBlock Text="Схема иллюстративная · показания на рисунке условные" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Border>
                        <Border Canvas.Left="40" Canvas.Top="566" Width="202" Height="49" Background="#F20B2B4B" BorderBrush="#7DBBE8" BorderThickness="1" CornerRadius="5" Padding="5,3">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="НАПРЯЖЕНИЕ" Foreground="#BBDCF3" FontSize="9"/><TextBlock x:Name="AnalogPv1Voltage" Text="— В" Foreground="White" FontSize="15" FontWeight="Bold"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="ТОК" Foreground="#BBDCF3" FontSize="9"/><TextBlock x:Name="AnalogPv1Current" Text="— А" Foreground="White" FontSize="15" FontWeight="Bold"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="МОЩНОСТЬ" Foreground="#BBDCF3" FontSize="9"/><TextBlock x:Name="AnalogPv1Power" Text="— Вт" Foreground="#FFD34E" FontSize="15" FontWeight="Bold"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border Canvas.Left="291" Canvas.Top="566" Width="202" Height="49" Background="#F20B2B4B" BorderBrush="#7DBBE8" BorderThickness="1" CornerRadius="5" Padding="5,3">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="НАПРЯЖЕНИЕ" Foreground="#BBDCF3" FontSize="9"/><TextBlock x:Name="AnalogPv2Voltage" Text="— В" Foreground="White" FontSize="15" FontWeight="Bold"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="ТОК" Foreground="#BBDCF3" FontSize="9"/><TextBlock x:Name="AnalogPv2Current" Text="— А" Foreground="White" FontSize="15" FontWeight="Bold"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="МОЩНОСТЬ" Foreground="#BBDCF3" FontSize="9"/><TextBlock x:Name="AnalogPv2Power" Text="— Вт" Foreground="#FFD34E" FontSize="15" FontWeight="Bold"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border Canvas.Left="40" Canvas.Top="619" Width="202" Height="27" Background="#E60B2B4B" CornerRadius="4" Padding="6,3">
                            <TextBlock x:Name="AnalogPv1Energy" Text="Энергия: — кВт·ч" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border Canvas.Left="291" Canvas.Top="619" Width="202" Height="27" Background="#E60B2B4B" CornerRadius="4" Padding="6,3">
                            <TextBlock x:Name="AnalogPv2Energy" Text="Энергия: — кВт·ч" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </Canvas>
                </Viewbox>
            </Grid>
            <Grid x:Name="EnergyMapDashboard" Grid.Row="0" Visibility="Collapsed" Margin="0">
                <Viewbox Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Canvas Width="1409" Height="905">
                        <Canvas x:Name="EnergyMapSvgHost" Width="1409" Height="905"/>
                        <Canvas x:Name="EnergyMapObjectHitCanvas" Width="1409" Height="905" IsHitTestVisible="False"/>
                        <Border x:Name="EnergyMapToolbar" Canvas.Left="930" Canvas.Top="16" Width="470" Height="46" Background="#E6103155" BorderBrush="#8BC9F5" BorderThickness="1" CornerRadius="9" Padding="8,5" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="EnergyMapEditButton" Content="Перемещать" Visibility="Collapsed" Click="EnergyMapEdit_Click" Padding="10,4" Background="#F5B942" Foreground="#17202D" BorderThickness="0" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <Button x:Name="EnergyMapElementsButton" Content="Элементы" Visibility="Collapsed" Click="EnergyMapElements_Click" Padding="10,4" Background="#63D6A2" Foreground="#17202D" BorderThickness="0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Canvas x:Name="EnergyMapItemsCanvas" Width="1409" Height="905"/>
                    </Canvas>
                </Viewbox>
            </Grid>
            <Grid x:Name="DigitalDashboard" Visibility="Collapsed" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Column="0" Grid.Row="0" Background="#172B40" BorderBrush="#31516B" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,10,12"><StackPanel><TextBlock Text="СОЛНЕЧНАЯ ПАНЕЛЬ 1" Foreground="#F5B942" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="DigitalPv1Power" Text="1 084 Вт" Foreground="#F5B942" FontSize="25" FontWeight="Bold" Margin="0,7,0,4"/><TextBlock x:Name="DigitalPv1Voltage" Text="186,4 В" Foreground="#F0F5FA" FontSize="17"/><TextBlock x:Name="DigitalPv1Current" Text="5,82 А" Foreground="#AFC1D2" FontSize="15"/></StackPanel></Border>
                <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Margin="5,0,5,12"><Border Background="#247DB5" Height="4" CornerRadius="2"/><TextBlock x:Name="DigitalPv1LinePower" Text="1,08 кВт" Foreground="#F5B942" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Background="#0B1725" Padding="8,3"/><TextBlock Text="PV 1 → ИНВЕРТОР" Foreground="#8FA2BA" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                <StackPanel Grid.Column="3" Grid.Row="0" VerticalAlignment="Center" Margin="5,0,5,12"><Border Background="#63D6A2" Height="4" CornerRadius="2"/><TextBlock x:Name="DigitalHouseLinePower" Text="— кВт" Foreground="#63D6A2" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Background="#0B1725" Padding="8,3"/><TextBlock Text="ИНВЕРТОР → ДОМ" Foreground="#8FA2BA" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                <Border Grid.Column="4" Grid.Row="0" Background="#172B40" BorderBrush="#31516B" BorderThickness="1" CornerRadius="10" Padding="13" Margin="10,0,0,12"><StackPanel><TextBlock Text="ДОМ" Foreground="#E8EEF7" FontWeight="Bold" FontSize="13"/><TextBlock x:Name="DigitalHousePower" Text="Потребление: — кВт·ч" Foreground="#F5B942" FontSize="19" FontWeight="Bold" Margin="0,7,0,4"/><TextBlock x:Name="DigitalHouseVoltage" Text="Напряжение: — В" Foreground="#F0F5FA" FontSize="14"/><TextBlock x:Name="DigitalHouseCurrent" Text="Ток: — А" Foreground="#AFC1D2" FontSize="14"/></StackPanel></Border>
                <Border Grid.Column="0" Grid.Row="1" Background="#172B40" BorderBrush="#31516B" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,10,12"><StackPanel><TextBlock Text="СОЛНЕЧНАЯ ПАНЕЛЬ 2" Foreground="#F5B942" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="DigitalPv2Power" Text="758 Вт" Foreground="#F5B942" FontSize="25" FontWeight="Bold" Margin="0,7,0,4"/><TextBlock x:Name="DigitalPv2Voltage" Text="182,1 В" Foreground="#F0F5FA" FontSize="17"/><TextBlock x:Name="DigitalPv2Current" Text="4,16 А" Foreground="#AFC1D2" FontSize="15"/></StackPanel></Border>
                <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Margin="5,0,5,12"><Border Background="#247DB5" Height="4" CornerRadius="2"/><TextBlock x:Name="DigitalPv2LinePower" Text="0,76 кВт" Foreground="#F5B942" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Background="#0B1725" Padding="8,3"/><TextBlock Text="PV 2 → ИНВЕРТОР" Foreground="#8FA2BA" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Background="#1A3047" BorderBrush="#F5B942" BorderThickness="2" CornerRadius="16" Padding="16" Margin="18,42,18,42" Panel.ZIndex="2" VerticalAlignment="Center"><StackPanel><TextBlock Text="ИНВЕРТОР" Foreground="#F5B942" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center"/><Border Background="#07111D" BorderBrush="#45617A" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,10,0,0"><StackPanel><TextBlock Text="ТЕКУЩАЯ МОЩНОСТЬ PV" Foreground="#8FA2BA" FontSize="10" HorizontalAlignment="Center"/><TextBlock x:Name="DigitalInverterPower" Text="1 842 Вт" Foreground="#63D6A2" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="DigitalInverterInfo" Text="Дополнительная телеметрия пока недоступна" Foreground="#AFC1D2" FontSize="10" TextWrapping="Wrap" HorizontalAlignment="Center"/></StackPanel></Border></StackPanel></Border>
                <Border Grid.Column="0" Grid.Row="2" Background="#172B40" BorderBrush="#31516B" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,10,0"><StackPanel><TextBlock Text="ЭЛЕКТРОСЕТЬ ЛЭП" Foreground="#63B9F2" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="DigitalGridEnergy" Text="Потребление: — кВт·ч" Foreground="#F0F5FA" FontSize="15" Margin="0,7,0,3"/><TextBlock x:Name="DigitalGridVoltage" Text="Напряжение: — В" Foreground="#AFC1D2" FontSize="14"/></StackPanel></Border>
                <StackPanel Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Margin="5,0,5,0"><Border Background="#63B9F2" Height="4" CornerRadius="2"/><TextBlock x:Name="DigitalGridLinePower" Text="— кВт" Foreground="#63B9F2" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Background="#0B1725" Padding="8,3"/><TextBlock Text="ЛЭП ↔ ИНВЕРТОР" Foreground="#8FA2BA" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                <StackPanel Grid.Column="3" Grid.Row="1" VerticalAlignment="Center" Margin="5,0,5,12"><Border Background="#63D6A2" Height="4" CornerRadius="2"/><TextBlock x:Name="DigitalBatteryLinePower" Text="— кВт" Foreground="#63D6A2" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Background="#0B1725" Padding="8,3"/><TextBlock Text="АКБ → ИНВЕРТОР · ЗАРЯД" Foreground="#63D6A2" FontSize="10" HorizontalAlignment="Center"/><Border Background="#E45B5B" Height="4" CornerRadius="2" Margin="0,9,0,0"/><TextBlock x:Name="DigitalBatteryDischargePower" Text="— кВт" Foreground="#E45B5B" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Background="#0B1725" Padding="8,3"/><TextBlock Text="ИНВЕРТОР → АКБ · РАЗРЯД" Foreground="#E45B5B" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                <Border Grid.Column="4" Grid.Row="1" Grid.RowSpan="2" Background="#172B40" BorderBrush="#31516B" BorderThickness="1" CornerRadius="10" Padding="13" Margin="10,0,0,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="АККУМУЛЯТОР" Foreground="#63D6A2" FontWeight="Bold" FontSize="13"/><TextBlock x:Name="DigitalBatteryVoltage" Text="Напряжение: — В" Foreground="#F0F5FA" FontSize="15" Margin="0,9,0,2"/><TextBlock x:Name="DigitalBatteryPercent" Text="Заряд: — %" Foreground="#F5B942" FontSize="21" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse x:Name="DigitalBatteryChargeLamp" Width="12" Height="12" Fill="#64748B" Margin="0,0,6,0"/><TextBlock x:Name="DigitalBatteryState" Text="Нет данных" Foreground="#AFC1D2" FontSize="12"/></StackPanel><TextBlock x:Name="DigitalBatteryPower" Text="Мощность: — кВт" Foreground="#AFC1D2" FontSize="14" Margin="0,8,0,0"/></StackPanel></Border>
            </Grid>
                <StackPanel x:Name="LegacyDashboard" Grid.Row="1">
                <Grid x:Name="TopMetricsGrid" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="ТЕКУЩАЯ МОЩНОСТЬ" Foreground="#8FA2BA" FontSize="11" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock x:Name="TotalPowerText" Text="1 842" FontSize="34" FontWeight="SemiBold"/>
                                <TextBlock Text=" Вт" FontSize="17" Foreground="#8FA2BA" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                            <TextBlock Text="Сумма выбранных солнечных строк" Foreground="#8FA2BA" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="НАКОПЛЕННАЯ ЭНЕРГИЯ" Foreground="#8FA2BA" FontSize="11" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock x:Name="TotalEnergyText" Text="12 846,0" FontSize="34" FontWeight="SemiBold"/>
                                <TextBlock Text=" кВт·ч" FontSize="17" Foreground="#8FA2BA" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                            <TextBlock Text="Суммарный счётчик станции" Foreground="#8FA2BA" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="СОСТОЯНИЕ СИСТЕМЫ" Foreground="#8FA2BA" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="SystemStateText" Text="Ожидание подключения" FontSize="20" FontWeight="SemiBold" Margin="0,15,0,0"/>
                            <TextBlock x:Name="LastUpdateText" Text="Обновлено: —" Foreground="#8FA2BA" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="СОЛНЕЧНЫЕ СТРОКИ" FontSize="12" FontWeight="Bold" Foreground="#8FA2BA" Margin="2,7,0,12"/>
                <Grid x:Name="StringCardsGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="PV 1" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="String1State" Text="ДЕМО" Foreground="#F5B942" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <TextBlock x:Name="String1Power" Text="1 084 Вт" FontSize="29" FontWeight="SemiBold" Foreground="#F5B942" Margin="0,13,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Напряжение" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String1Voltage" Text="186,4 В" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Ток" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String1Current" Text="5,82 А" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Энергия" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String1Energy" Text="7 214,6 кВт·ч" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="PV 2" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="String2State" Text="ДЕМО" Foreground="#F5B942" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <TextBlock x:Name="String2Power" Text="758 Вт" FontSize="29" FontWeight="SemiBold" Foreground="#F5B942" Margin="0,13,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Напряжение" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String2Voltage" Text="182,1 В" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Ток" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String2Current" Text="4,16 А" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Энергия" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String2Energy" Text="5 631,4 кВт·ч" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="#121E30" CornerRadius="12" Padding="17" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ПОДКЛЮЧЕНИЕ К КОНТРОЛЛЕРУ" FontWeight="Bold" FontSize="11" Foreground="#8FA2BA"/>
                            <TextBlock x:Name="NetworkInfoText" Text="Пока отображаются локальные демонстрационные значения." Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="PollInfoText" Text="Опрос: выключен" Foreground="#8FA2BA" VerticalAlignment="Center"/>
                            <Button Content="Журнал связи" Click="OpenConnectionLog_Click" Margin="14,0,0,0"
                                    Padding="11,6" Background="#26384D" Foreground="#E8EEF7" BorderThickness="0"
                                    ToolTip="Открыть журнал подключений и ошибок"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="2,12,2,0">
            <TextBlock x:Name="VersionText" Text="Solar_PV Desktop" Foreground="#71849B" FontSize="11"/>
            <TextBlock Text="Клиент Windows 10 / 11 · режим чтения" Foreground="#71849B" FontSize="11" DockPanel.Dock="Right"/>
        </DockPanel>
        </Grid>
    </Grid>
</Window>
