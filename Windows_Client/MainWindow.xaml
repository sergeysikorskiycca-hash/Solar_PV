<Window x:Class="SolarPV.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solar_PV — Панель станции" Height="790" Width="1180"
        MinHeight="680" MinWidth="980" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Menu x:Name="MainMenu" Grid.Row="0" Padding="8,3" Background="#17263A" Foreground="#E8EEF7">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Темы оформления">
                    <MenuItem Header="Классическая светлая" Tag="Light" Click="Theme_Click"/>
                    <MenuItem Header="Office" Tag="Office" Click="Theme_Click"/>
                    <Separator/>
                    <MenuItem Header="Тёмная" Tag="Dark" Click="Theme_Click"/>
                    <MenuItem Header="Графитовая" Tag="Graphite" Click="Theme_Click"/>
                    <MenuItem Header="Синяя" Tag="Blue" Click="Theme_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Инструменты">
                <MenuItem Header="Подключить ESP32" Click="Connect_Click"/>
                <MenuItem Header="Демонстрационный режим" Click="Demo_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="Проверить обновления…" Click="CheckUpdates_Click"/>
                <Separator/>
                <MenuItem Header="О программе Solar_PV" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="26,18,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Солнечная генерация" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="DataModeText" Text="  ·  демонстрационные данные" Foreground="#8FA2BA" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="AddressBox" Width="190" Text="http://192.168.4.1" Padding="10,8"
                         Background="#17263A" Foreground="#E8EEF7" BorderBrush="#30445E" VerticalContentAlignment="Center"/>
                <Button x:Name="ConnectButton" Content="Подключить ESP32" Click="Connect_Click" Margin="9,0,0,0"
                        Padding="15,8" Background="#F5B942" Foreground="#17202D" BorderThickness="0" FontWeight="SemiBold"/>
                <Button Content="Демо" Click="Demo_Click" Margin="8,0,0,0" Padding="15,8"
                        Background="#26384D" Foreground="#E8EEF7" BorderThickness="0"/>

            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="ТЕКУЩАЯ МОЩНОСТЬ" Foreground="#8FA2BA" FontSize="11" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock x:Name="TotalPowerText" Text="1 842" FontSize="34" FontWeight="SemiBold"/>
                                <TextBlock Text=" Вт" FontSize="17" Foreground="#8FA2BA" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                            <TextBlock Text="Сумма выбранных солнечных строк" Foreground="#8FA2BA" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="НАКОПЛЕННАЯ ЭНЕРГИЯ" Foreground="#8FA2BA" FontSize="11" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock x:Name="TotalEnergyText" Text="12 846,0" FontSize="34" FontWeight="SemiBold"/>
                                <TextBlock Text=" кВт·ч" FontSize="17" Foreground="#8FA2BA" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                            </StackPanel>
                            <TextBlock Text="Суммарный счётчик станции" Foreground="#8FA2BA" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="СОСТОЯНИЕ СИСТЕМЫ" Foreground="#8FA2BA" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="SystemStateText" Text="Ожидание подключения" FontSize="20" FontWeight="SemiBold" Margin="0,15,0,0"/>
                            <TextBlock x:Name="LastUpdateText" Text="Обновлено: —" Foreground="#8FA2BA" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="СОЛНЕЧНЫЕ СТРОКИ" FontSize="12" FontWeight="Bold" Foreground="#8FA2BA" Margin="2,7,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="PV 1" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="String1State" Text="ДЕМО" Foreground="#F5B942" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <TextBlock x:Name="String1Power" Text="1 084 Вт" FontSize="29" FontWeight="SemiBold" Foreground="#F5B942" Margin="0,13,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Напряжение" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String1Voltage" Text="186,4 В" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Ток" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String1Current" Text="5,82 А" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Энергия" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String1Energy" Text="7 214,6 кВт·ч" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="PV 2" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="String2State" Text="ДЕМО" Foreground="#F5B942" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <TextBlock x:Name="String2Power" Text="758 Вт" FontSize="29" FontWeight="SemiBold" Foreground="#F5B942" Margin="0,13,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Напряжение" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String2Voltage" Text="182,1 В" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Ток" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String2Current" Text="4,16 А" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Энергия" Foreground="#8FA2BA" FontSize="11"/><TextBlock x:Name="String2Energy" Text="5 631,4 кВт·ч" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="#121E30" CornerRadius="12" Padding="17" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ПОДКЛЮЧЕНИЕ К КОНТРОЛЛЕРУ" FontWeight="Bold" FontSize="11" Foreground="#8FA2BA"/>
                            <TextBlock x:Name="NetworkInfoText" Text="Пока отображаются локальные демонстрационные значения." Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="PollInfoText" Grid.Column="1" Text="Опрос: выключен" Foreground="#8FA2BA" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="2,12,2,0">
            <TextBlock x:Name="VersionText" Text="Solar_PV Desktop" Foreground="#71849B" FontSize="11"/>
            <TextBlock Text="Клиент Windows 10 / 11 · режим чтения" Foreground="#71849B" FontSize="11" DockPanel.Dock="Right"/>
        </DockPanel>
        </Grid>
    </Grid>
</Window>
